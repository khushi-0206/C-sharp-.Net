@model StudentPortalWebApp.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-danger text-white text-center rounded-top-4">
                    <h3 class="mb-0">⚠ Confirm Deletion</h3>
                </div>

                <div class="card-body p-4">

                    <div class="alert alert-warning text-center">
                        <strong>Are you sure you want to delete this student?</strong>
                        <br />
                        This action cannot be undone.
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Full Name:</div>
                        <div class="col-sm-8">@Model.FullName</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Email:</div>
                        <div class="col-sm-8">@Model.Email</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Phone:</div>
                        <div class="col-sm-8">@Model.Phone</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Status:</div>
                        <div class="col-sm-8">@Model.Status</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Join Date:</div>
                        <div class="col-sm-8">@Model.JoinDate.ToShortDateString()</div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-sm-4 fw-bold">Created At:</div>
                        <div class="col-sm-8">@Model.CreatedAt.ToString("g")</div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="StudentId" />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg rounded-3">
                                🗑 Delete Student
                            </button>

                            <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
                                ⬅ Cancel
                            </a>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>