@model List<StudentPortalWebApp.Models.Student>

@{
    ViewData["Title"] = "Students";
    var q = (ViewBag.Query as string) ?? "";
}

<div class="container mt-4">

    <div class="card shadow-lg border-0 rounded-4 p-4">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="mb-0">📚 Students</h2>
                <small class="text-muted">CRUD + Live Search</small>
            </div>
            <a class="btn btn-primary rounded-3 px-4" asp-action="Create">
                ➕ Add Student
            </a>
        </div>

        <!-- Search -->
        <div class="row g-2 mb-3">
            <div class="col-md-5">
                <input id="q" class="form-control rounded-3"
                       placeholder="Search by name or email..."
                       value="@q" />
            </div>
            <div class="col-md-auto">
                <button id="btnSearch" class="btn btn-outline-primary rounded-3">
                    🔍 Search
                </button>
            </div>
        </div>

        <div id="liveBox" class="small text-muted mb-3"></div>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th style="width:220px;">Actions</th>
                    </tr>
                </thead>
                <tbody id="tblBody">
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.StudentId</td>
                            <td>@s.FullName</td>
                            <td>@s.Email</td>
                            <td>
                                @if (s.Status == "Active")
                                {
                                    <span class="badge bg-success px-3 py-2">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2">@s.Status</span>
                                }
                            </td>
                            <td>
                                <a class="btn btn-sm btn-warning rounded-3"
                                   asp-action="Edit"
                                   asp-route-id="@s.StudentId">
                                    ✏ Edit
                                </a>

                                <a class="btn btn-sm btn-danger rounded-3"
                                   asp-action="Delete"
                                   asp-route-id="@s.StudentId">
                                    🗑 Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        const qEl = document.getElementById("q");
        const box = document.getElementById("liveBox");
        const tbody = document.getElementById("tblBody");
        const btn = document.getElementById("btnSearch");

        let t = null;

        function renderRows(items){
            if(!items || items.length === 0){
                tbody.innerHTML = `<tr><td colspan="5" class="text-center">No results found</td></tr>`;
                return;
            }

            tbody.innerHTML = items.map(s => `
                <tr>
                    <td>${s.studentId}</td>
                    <td>${s.fullName}</td>
                    <td>${s.email}</td>
                    <td>
                        ${s.status === "Active"
                            ? '<span class="badge bg-success px-3 py-2">Active</span>'
                            : '<span class="badge bg-secondary px-3 py-2">'+s.status+'</span>'}
                    </td>
                    <td>
                        <a class="btn btn-sm btn-warning rounded-3"
                           href="/Students/Edit/${s.studentId}">
                           ✏ Edit
                        </a>
                        <a class="btn btn-sm btn-danger rounded-3"
                           href="/Students/Delete/${s.studentId}">
                           🗑 Delete
                        </a>
                    </td>
                </tr>
            `).join("");
        }

        async function liveSearch(){
            const q = qEl.value.trim();

            if(q.length === 0){
                box.textContent = "";
                return;
            }

            box.textContent = "Searching...";

            const res = await fetch(`/Students/Search?q=${encodeURIComponent(q)}`);
            const data = await res.json();

            box.textContent = `Found: ${data.length}`;
            renderRows(data);
        }

        qEl.addEventListener("keyup", () => {
            clearTimeout(t);
            t = setTimeout(liveSearch, 300);
        });

        btn.addEventListener("click", liveSearch);
    </script>
}