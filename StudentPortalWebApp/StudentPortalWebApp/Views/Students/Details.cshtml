@model StudentPortalWebApp.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-info text-white text-center rounded-top-4">
                    <h3 class="mb-0">📋 Student Details</h3>
                </div>

                <div class="card-body p-4">

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Full Name:</div>
                        <div class="col-sm-8">@Model.FullName</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Email:</div>
                        <div class="col-sm-8">@Model.Email</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Phone:</div>
                        <div class="col-sm-8">@Model.Phone</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Status:</div>
                        <div class="col-sm-8">
                            @if (Model.Status == "Active")
                            {
                                <span class="badge bg-success px-3 py-2">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-3 py-2">@Model.Status</span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Join Date:</div>
                        <div class="col-sm-8">
                            @Model.JoinDate.ToShortDateString()
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-sm-4 fw-bold">Created At:</div>
                        <div class="col-sm-8">
                            @Model.CreatedAt.ToString("f")
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Edit" asp-route-id="@Model.StudentId"
                           class="btn btn-warning rounded-3 px-4">
                            ✏ Edit
                        </a>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary rounded-3 px-4">
                            ⬅ Back to List
                        </a>
                    </div>

                </div>

            </div>

        </div>
    </div>
</div>