@using AuthenticationDemo.Models
@{
    int count = CartStorage.CartItems.Sum(c => c.Quantity);
}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <table class="table table-bordered">
        <tr>
            <td>
                <img src="/Images/Logo.png" width="50px" />
            </td>
            <td>
                <h2>Welcome To Shopping Website</h2>
            </td>
            <tc>
                <a href="/Cart/Index" class="btn btn-outline-warning">
                    Cart(@count)</a>
            </tc>
        </tr>
        <tr>
            <td>
                <a href="/Product/Index1" class="btn btn-primary">Cosmetics    </a> <br /> <br />
                <a href="/Product/Index2" class="btn btn-primary">Electronics  </a> <br /> <br />
                <a href="/Product/Index3" class="btn btn-primary">Cloths       </a> <br /> <br />
                
            </td>
            <td>
                <div>
                    @RenderBody() <!-- Area that are being rendered(changed)-->
                </div>
            </td>
        </tr>

    </table>
    
</body>
</html>
